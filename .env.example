# `all` monitors every local container. Otherwise use exact names: api,worker,postgres
CONTAINERS=all
CHECK_INTERVAL_MS=60000

# Spring cron: second minute hour day-of-month month day-of-week
WEEKLY_REPORT_CRON=0 0 9 * * MON
REPORT_TIMEZONE=UTC
DOCKER_COMMAND=docker

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=replace-me
SMTP_AUTH=true
SMTP_STARTTLS=true
# Use true only for implicit TLS, typically port 465. Port 587 uses STARTTLS.
SMTP_SSL_ENABLE=false
SMTP_TO=ops@example.com
SUBJECT_PREFIX=[Docker Watchdog]

# Timeouts are in milliseconds. Leave SOCKS settings empty unless your network
# provides a SOCKS proxy; HTTPS proxies cannot directly proxy SMTP traffic.
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_TIMEOUT_MS=10000
SMTP_WRITE_TIMEOUT_MS=10000
SMTP_SOCKS_HOST=
SMTP_SOCKS_PORT=1080
